# 复制成 deploy/.env 后按需改；compose 会用同名变量覆盖这里的默认值。
# 变量口径与 docs/DEPLOY.md 的变量表一致。

# 必填：会话签名与令牌派生的根秘密，至少 32 字符。生成方式：openssl rand -hex 32
SESSION_SECRET=change-me-openssl-rand-hex-32

# 反代终结 TLS（`--profile proxy` 起 Caddy 反代档案）时**两个都要置 1**：
# COOKIE_SECURE 置 1 ⇒ 会话 cookie 带 Secure；TRUST_PROXY 置 1 ⇒ 采信反代透传的转发头。
# 不起反代、直连 HTTP 时两个都保持 0；只置其中一个都会与实际口径不符。
COOKIE_SECURE=0
TRUST_PROXY=0

# 日志级别：debug / info / warn / error
LOG_LEVEL=info

# 监听地址与端口（容器内固定 0.0.0.0:3000，一般不用改）
HOST=0.0.0.0
PORT=3000

# 库与备份落点（容器内是卷挂载点）
DB_PATH=/data/shop.db
BACKUP_DIR=/data/backups
BACKUP_RETENTION_DAYS=14

# 请求体上限（字节）与写接口限流窗口 / 上限
BODY_LIMIT_BYTES=131072
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# 运行环境：production 下必须提供 SESSION_SECRET
NODE_ENV=production
