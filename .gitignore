# 依赖与本地缓存（沙箱环境下 npm 缓存必须落在工作区内）
node_modules/
.npm-cache/

# 过程载体：一次性脚本 / 探针 / 取证（含登记区），不进版本库
docs/process/tools/

# 报告与批次归档：过程产物，不进版本库
reports/

# 运行时产物
*.log
.DS_Store

# journal 写入器每次追加都会重写的上一版备份（回滚用），属瞬时文件，不入库
docs/process/prd/*.journal.jsonl.bak

# Phase 2：数据库与运行时数据（不入库；路径由配置指定，属运行时产物）
data/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite-wal
*.sqlite-shm

# Phase 2：本地配置与密钥（`.env.example` 入库，真实 `.env` 永不入库）
.env
.env.local
.env.production
